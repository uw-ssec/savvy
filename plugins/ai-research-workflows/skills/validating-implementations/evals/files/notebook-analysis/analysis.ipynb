    "# Bootstrap mean of station temperatures"
   ]
  },
  {
   "cell_type": "code",
   "id": "analysis",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import csv, random, statistics\n",
    "temps = [float(r['temp']) for r in csv.DictReader(open('data/temps.csv'))]\n",
    "means = [statistics.mean(random.choices(temps, k=len(temps))) for _ in range(1000)]\n",
    "print(round(statistics.mean(means), 2))"
   ]
  }
 ]
